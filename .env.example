# Copy this file to .env.local and adjust the values for your machine.
# NEVER commit .env.local or any real credentials.

# Public URL of the site. Used for metadataBase, canonical URLs and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# SQLite database file (relative to the project root or absolute).
DATABASE_PATH=./data/kids-island.db

# Upload folder. Must be inside ./public so Next.js can serve media publicly.
UPLOAD_DIR=./public/uploads

# ---------------------------------------------------------------------------
# Bootstrap-only variables (read by `npm run bootstrap` / `npm run reset-admin`,
# never exposed to the browser). Leave ADMIN_PASSWORD unset to have the script
# generate a strong random password and write it to data/initial-admin.txt.
# ---------------------------------------------------------------------------
# ADMIN_EMAIL=admin@example.com
# ADMIN_NAME=Master Admin
# ADMIN_PASSWORD=
